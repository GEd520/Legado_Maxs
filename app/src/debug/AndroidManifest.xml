<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建变体参与合并的 Manifest。
  作用：把「书源调试 / 订阅源调试」页标记为 exported，使 adb shell am start 能以 -n 指定组件、并用字符串 extra "key" 传入源 URL
  直接从 shell 拉起这两个内部页，实现免 UI 点击的端到端验证（详见 docs/architecture/Web服务端到端测试方法.md 第十节）。
  release 构建不含本文件，这两个页保持默认未导出状态，对外不可启动。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".ui.book.source.debug.BookSourceDebugActivity"
            android:exported="true" />
        <activity
            android:name=".ui.rss.source.debug.RssSourceDebugActivity"
            android:exported="true" />
    </application>

</manifest>
